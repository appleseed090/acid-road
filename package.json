{
  "name": "acid-road",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A live browser ride down a straight road through random block terrain that warps as you travel.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "check": "npm run lint && npm run build && npm test && npm run test:smoke",
    "contact-sheet": "node scripts/contact-sheet.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "4.0.18"
  }
}
